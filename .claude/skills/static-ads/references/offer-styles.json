  "overhang_note": "overhang (em, per side) is how far inked letters reach past their layout box. The renderer reserves it plus the widest outline, so ink never leaves the region. Script swashes and italic slant reach much further than upright sans. Values are verified by the zero-pixel leak test, which runs for every style.",
  "script_rules": {
    "blocks": [
      "audience"
    ],
    "min_px": 52,
    "max_chars": 24
  },
  "effects": {
    "fill": "Solid fill with the palette's thin outline and a soft shadow. Legibility is judged on the fill colour.",
    "outline-bold": "Solid fill with a heavy outline in the palette's outline colour. A letter reads if either its fill or its outline stands out from the photo, so it is judged on the better of the two.",
    "hollow": "Outline only, drawn in the line's fill colour, no fill. Judged on that colour.",
    "band": "Solid rounded band behind the line in the palette's pill colour. Judged on text against the band."
  },
