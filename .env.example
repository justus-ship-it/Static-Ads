# Google Gemini API Key (required - primary image generator)
# Get yours at: https://aistudio.google.com
GEMINI_KEY=your-gemini-api-key-here

# FAL.ai API Key (optional - backup image generator)
# Get yours at: https://fal.ai
FAL_KEY=your-fal-api-key-here

# Apify API token (required for Phase 0 — competitor swipe intelligence)
# Used by skills/references/scrape-meta-ads.mjs to pull gym ads from the
# Meta Ad Library via an Apify actor. Get yours at: https://console.apify.com/account/integrations
APIFY_TOKEN=your-apify-token-here

# Apify actor ID for the Meta Ad Library scraper (optional override).
# Defaults to a public Facebook Ad Library actor if unset.
APIFY_ADLIB_ACTOR=curious_coder~facebook-ads-library-scraper
