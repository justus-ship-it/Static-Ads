# Google Gemini API key (required: every picture, check and draft)
# Get yours at: https://aistudio.google.com — paste only the key after the "=", no label in front of it.
GEMINI_KEY=your-gemini-api-key-here

# Meta Marketing API (the Meta link, publishing, results, targeting import, Instagram onboarding).
# Strategym's own Live app and a system user whose partner-shared access reaches every client's ad
# account and Page: one app for all gyms. SETUP-GUIDE.md and the panel's Meta link page say how.
# Tokens never go in a gym's profile file; they live here only.
META_ACCESS_TOKEN=your-meta-system-user-token-here
META_APP_ID=your-meta-app-id-here
META_APP_SECRET=your-meta-app-secret-here

# A gym may carry its own keys instead: the gym's folder name upper-cased, hyphens as underscores,
# as a suffix. They win over the shared ones for that gym.
# META_ACCESS_TOKEN_SCULPT_SOCIETY=
# META_APP_ID_SCULPT_SOCIETY=
# META_APP_SECRET_SCULPT_SOCIETY=

# Apify API token (the swipe-intel skill only: gym ads from the Meta Ad Library through an Apify actor)
# Get yours at: https://console.apify.com/account/integrations
APIFY_TOKEN=your-apify-token-here
# Apify actor id for the Meta Ad Library scraper (optional override; a public actor is the default).
APIFY_ADLIB_ACTOR=curious_coder~facebook-ads-library-scraper

# FAL.ai API key (the unused backup generator, generate_ads.mjs)
FAL_KEY=your-fal-api-key-here
